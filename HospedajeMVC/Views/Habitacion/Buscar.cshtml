@model IEnumerable<HospedajeMvc.Models.Habitacion>

@{
    ViewData["Title"] = "Módulo de Búsqueda de Habitaciones";
}

<div class="container mt-4">
    <h2>Módulo de Búsqueda de Habitaciones</h2>
    <p class="text-muted">Busque una habitación de manera independiente por su identificación o tipo.</p>

    <form asp-action="Buscar" method="get" class="row g-3 mb-4">
        <div class="col-md-8">
            <input type="text" name="criterioBusqueda" class="form-control"
                   placeholder="Digite la identificación o el tipo a buscar..."
                   value="@ViewData["CriterioActual"]" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">Procesar Búsqueda</button>
        </div>
    </form>

    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Resultados encontrados</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Identificación</th>
                        <th>Tipo de habitación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var habitacion in Model)
                        {
                            <tr>
                                <td>@habitacion.HabitacionId</td>
                                <td>@habitacion.TipoHabitacion</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@habitacion.HabitacionId" class="btn btn-sm btn-warning">Editar</a>
                                </td>
                            </tr>
                        }
                    }
                    else if (ViewData["CriterioActual"] != null)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-danger">No se encontraron habitaciones que coincidan con la búsqueda.</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">Ingrese un criterio arriba y presione el botón para buscar.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Regresar al Listado General</a>
    </div>
</div>
