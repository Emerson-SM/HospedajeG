@model IEnumerable<HospedajeMvc.Models.Reservacion>

@{
    ViewData["Title"] = "Listado de Reservaciones";
}

<div class="container mt-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-calendar-check-fill text-success"></i> Gestión de Reservaciones
            </h2>
            <p class="text-muted small mb-0">Control de ingresos, salidas y estados de hospedaje en tiempo real.</p>
        </div>

        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="Create" class="btn btn-success fw-bold px-3 shadow-sm">
                <i class="bi bi-plus-circle-fill"></i> Crear Reservación
            </a>
            <a asp-controller="Reservacion" asp-action="Buscar" class="btn btn-outline-primary px-3 shadow-sm">
                <i class="bi bi-search"></i> Módulo de Búsqueda
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7 tracking-wider">
                    <tr>
                        <th class="ps-4">Código</th>
                        <th class="text-center">Cliente ID</th>
                        <th class="text-center">Habitación</th>
                        <th class="text-center">Fechas (Inicio / Salida)</th>
                        <th class="text-center">Noches</th>
                        <th class="text-center">Monto Total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-4">Acciones y Gestión</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted fs-5">
                                <i class="bi bi-calendar-x d-block fs-1 opacity-50 mb-2"></i>
                                No hay reservaciones registradas en este momento.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="bi bi-hash text-muted me-1"></i>@item.ReservacionId
                                </td>

                                <td class="text-center text-muted font-monospace">
                                    @item.ClienteId
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-light text-primary border border-primary-subtle px-3 py-2 fw-bold">
                                        <i class="bi bi-door-closed-fill me-1"></i> N° @item.HabitacionId
                                    </span>
                                </td>

                                <td class="text-center text-muted small">
                                    <!-- CORREGIDO: Cambiado FechaIngreso por FechaInicio -->
                                    <div class="mb-1">
                                        <i class="bi bi-box-arrow-in-right text-success me-1"></i>@item.FechaInicio.ToString("dd/MM/yyyy")
                                    </div>
                                    <div>
                                        <i class="bi bi-box-arrow-left text-danger me-1"></i>@item.FechaSalida.ToString("dd/MM/yyyy")
                                    </div>
                                </td>

                                <td class="text-center fw-semibold text-dark">
                                    <!-- CORREGIDO: Cálculo de noches directo usando TimeSpan en lugar de propiedad faltante -->
                                    <i class="bi bi-moon me-1 text-secondary"></i>@((item.FechaSalida - item.FechaInicio).Days)
                                </td>

                                <td class="text-center fw-bold text-success">
                                    @item.MontoTotal.ToString("C")
                                </td>

                                <td class="text-center">
                                    <!-- CORREGIDO: Mapeo de estilos visuales alineado a los estados oficiales -->
                                    @if (item.Estado != null && (item.Estado.ToLower() == "reservada" || item.Estado.ToLower() == "en proceso"))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                            @item.Estado
                                        </span>
                                    }
                                    else if (item.Estado != null && item.Estado.ToLower() == "finalizada")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">
                                            @item.Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">
                                            @item.Estado
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group gap-1" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.ReservacionId" class="btn btn-sm btn-outline-primary rounded shadow-sm" title="Editar">
                                            <i class="bi bi-pencil-fill"></i> <span class="d-none d-lg-inline">Editar</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ReservacionId" class="btn btn-sm btn-outline-danger rounded shadow-sm" title="Eliminar">
                                            <i class="bi bi-trash3-fill"></i> <span class="d-none d-lg-inline">Eliminar</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .fs-7 {
        font-size: 0.82rem;
    }

    .tracking-wider {
        letter-spacing: 0.05em;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(248, 249, 250, 0.85);
    }
</style>