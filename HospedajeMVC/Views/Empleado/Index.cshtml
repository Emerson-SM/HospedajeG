@model IEnumerable<HospedajeMvc.Models.Empleado>

@{
    ViewData["Title"] = "Listado de Empleados";
}

<div class="container mt-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary"></i> Control de Empleados
            </h2>
            <p class="text-muted small mb-0">Mantenimiento general de empleados registrados en el sistema</p>
        </div>

        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="Create" class="btn btn-success fw-bold px-3 shadow-sm">
                <i class="bi bi-plus-circle-fill"></i> Registrar Empleado
            </a>
            <a asp-controller="Empleado" asp-action="Buscar" class="btn btn-outline-primary px-3 shadow-sm">
                <i class="bi bi-search"></i> Módulo de Búsqueda
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7 tracking-wider">
                    <tr>
                        <th class="ps-4">@Html.DisplayNameFor(model => model.FirstOrDefault().EmpleadoId)</th>
                        <th>Nombre Completo</th>
                        <th class="text-center">Fecha de Nacimiento</th>
                        <th class="text-end pe-4">Acciones y Gestión</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted fs-5">
                                <i class="bi bi-inbox-fill d-block fs-1 opacity-50 mb-2"></i>
                                No hay empleados registrados en este momento.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">
                                    @Html.DisplayFor(modelItem => item.EmpleadoId)
                                </td>

                                <td>
                                    <span class="fw-semibold text-dark">@item.NombreEmpleado</span>
                                    <span class="text-secondary">@item.PrimerApellidoEmpleado @item.SegundoApellidoEmpleado</span>
                                </td>

                                <td class="text-center text-muted">
                                    @if (item.FechaNacimientoEmpleado != null)
                                    {
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @item.FechaIngreso.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span>---</span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group gap-1" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.EmpleadoId" class="btn btn-sm btn-outline-primary rounded shadow-sm" title="Editar datos">
                                            <i class="bi bi-pencil-fill"></i> <span class="d-none d-sm-inline">Editar</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.EmpleadoId" class="btn btn-sm btn-outline-danger rounded shadow-sm" title="Eliminar registro">
                                            <i class="bi bi-trash3-fill"></i> <span class="d-none d-sm-inline">Eliminar</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<style>
    .fs-7 {
        font-size: 0.82rem;
    }

    .tracking-wider {
        letter-spacing: 0.05em;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(248, 249, 250, 0.85);
    }
</style>