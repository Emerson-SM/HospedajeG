@model HospedajeMvc.Models.Cliente

@{
    ViewData["Title"] = "Crear Cliente";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0 rounded-3">

                <div class="card-header bg-dark text-white text-center py-3">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill"></i> Crear Cliente</h3>
                    <small class="text-white-50">Ingrese los datos del nuevo cliente</small>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="formClienteCreate">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center"></div>

                        @* 1. Desplegable para Selección de Tipo de Identificación *@
                        <div class="mb-3">
                            <label asp-for="TipoIdentificacion" class="form-label fw-semibold"></label>
                            <select asp-for="TipoIdentificacion" asp-items="ViewBag.TiposIdentificacion" id="selectTipoIdentificacion" class="form-select">
                                <option value="">-- Seleccione un tipo --</option>
                            </select>
                            <span asp-validation-for="TipoIdentificacion" class="text-danger small"></span>
                        </div>

                        @* 2. Campo para Número de Identificación (Validado por JS) *@
                        <div class="mb-3">
                            <label asp-for="ClienteId" class="form-label fw-semibold"></label>
                            <input asp-for="ClienteId" id="inputClienteId" class="form-control" placeholder="Seleccione un tipo primero" autocomplete="off" />
                            <span asp-validation-for="ClienteId" id="errorClienteId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NombreCliente" class="form-label fw-semibold"></label>
                            <input asp-for="NombreCliente" class="form-control" placeholder="Escriba el nombre..." />
                            <span asp-validation-for="NombreCliente" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PrimerApellidoCliente" class="form-label fw-semibold"></label>
                            <input asp-for="PrimerApellidoCliente" class="form-control" placeholder="Escriba el primer apellido..." />
                            <span asp-validation-for="PrimerApellidoCliente" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SegundoApellidoCliente" class="form-label fw-semibold"></label>
                            <input asp-for="SegundoApellidoCliente" class="form-control" placeholder="Escriba el segundo apellido..." />
                            <span asp-validation-for="SegundoApellidoCliente" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FechaNacimientoCliente" class="form-label fw-semibold"></label>
                            <input asp-for="FechaNacimientoCliente" type="date" class="form-control" />
                            <span asp-validation-for="FechaNacimientoCliente" class="text-danger small"></span>
                        </div>

                        <hr />

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">
                                <i class="bi bi-save-fill"></i> Guardar Cliente
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary text-center">
                                Cancelar y Regresar
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const selectTipo = document.getElementById("selectTipoIdentificacion");
            const inputId = document.getElementById("inputClienteId");
            const errorSpan = document.getElementById("errorClienteId");

            function actualizarMascara() {
                const tipo = selectTipo.value;
                errorSpan.innerText = "";

                if (tipo === "Cédula") {
                    inputId.placeholder = "1-1111-0909 (Formato 9 dígitos)";
                    inputId.maxLength = 11;
                } else if (tipo === "DIMEX") {
                    inputId.placeholder = "12 dígitos numéricos";
                    inputId.maxLength = 12;
                } else if (tipo === "Pasaporte") {
                    inputId.placeholder = "Alfanumérico (ej: A12345678)";
                    inputId.maxLength = 50;
                } else {
                    inputId.placeholder = "Seleccione un tipo primero";
                    inputId.maxLength = 50;
                }
            }

            function validarFormatoId() {
                const tipo = selectTipo.value;
                const valor = inputId.value.trim();
                errorSpan.innerText = "";

                if (!tipo && valor.length > 0) {
                    errorSpan.innerText = "Debe seleccionar un tipo de identificación primero.";
                    return false;
                }

                if (valor.length === 0) return true;

                if (tipo === "Cédula") {
                    const regexCedula = /^\d{1}-\d{4}-\d{4}$/;
                    if (!regexCedula.test(valor)) {
                        errorSpan.innerText = "Formato de cédula inválido. Use X-XXXX-XXXX (ej: 1-1111-0909).";
                        return false;
                    }
                } else if (tipo === "DIMEX") {
                    const regexDimex = /^\d{12}$/;
                    if (!regexDimex.test(valor)) {
                        errorSpan.innerText = "El DIMEX debe contener exactamente 12 dígitos numéricos.";
                        return false;
                    }
                } else if (tipo === "Pasaporte") {
                    const regexPasaporte = /^[a-zA-Z0-9]{1,50}$/;
                    if (!regexPasaporte.test(valor)) {
                        errorSpan.innerText = "El pasaporte solo permite letras y números (máx. 50 caracteres).";
                        return false;
                    }
                }

                return true;
            }

            selectTipo.addEventListener("change", function() {
                inputId.value = "";
                actualizarMascara();
            });

            inputId.addEventListener("input", validarFormatoId);

            document.getElementById("formClienteCreate").addEventListener("submit", function(e) {
                if (!validarFormatoId()) {
                    e.preventDefault();
                }
            });

            actualizarMascara();
        });
    </script>
}