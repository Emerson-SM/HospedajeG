@model HospedajeMvc.Models.Cliente

@{
    ViewData["Title"] = "Eliminar cliente";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-2 rounded-3 mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-octagon-fill fs-4 me-2"></i>
                        <div>
                            <strong class="d-block">No se puede eliminar</strong>
                            @TempData["ErrorMessage"]
                        </div>
                    </div>
                </div>
            }

            <div class="card shadow-lg border-0 rounded-3">

                <div class="card-header bg-danger text-white text-center py-4">
                    <div class="fs-1 mb-1"><i class="bi bi-trash3-fill"></i></div>
                    <h3 class="mb-0 fw-bold">¿Eliminar este Cliente?</h3>
                    <p class="text-white-50 small mb-0">Esta acción no se puede deshacer de forma directa si confirma.</p>
                </div>

                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">Confirme si la ficha del siguiente cliente debe ser removida del sistema:</p>

                    <div class="bg-light p-3 rounded-3 mb-4 border-start border-danger border-3">
                        <div class="row mb-2 pb-2 border-bottom border-white">
                            <div class="col-sm-4 text-muted fw-semibold">@Html.DisplayNameFor(model => model.ClienteId):</div>
                            <div class="col-sm-8 fw-bold text-dark">@Html.DisplayFor(model => model.ClienteId)</div>
                        </div>
                        <div class="row mb-2 pb-2 border-bottom border-white">
                            <div class="col-sm-4 text-muted fw-semibold">Nombre:</div>
                            <div class="col-sm-8 fw-bold text-dark">@Html.DisplayFor(model => model.NombreCliente)</div>
                        </div>
                        <div class="row mb-2 pb-2 border-bottom border-white">
                            <div class="col-sm-4 text-muted fw-semibold">Primer Apellido:</div>
                            <div class="col-sm-8 fw-bold text-dark">@Html.DisplayFor(model => model.PrimerApellidoCliente)</div>
                        </div>
                        <div class="row mb-2 pb-2 border-bottom border-white">
                            <div class="col-sm-4 text-muted fw-semibold">Segundo Apellido:</div>
                            <div class="col-sm-8 fw-bold text-dark">@Html.DisplayFor(model => model.SegundoApellidoCliente)</div>
                        </div>
                        <div class="row mb-0">
                            <div class="col-sm-4 text-muted fw-semibold">Nacimiento:</div>
                            <div class="col-sm-8 fw-bold text-dark">
                                @if (Model.FechaNacimientoCliente != null)
                                {
                                    @Model.FechaNacimientoCliente.ToString("dd/MM/yyyy")
                                }
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="ClienteId" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold shadow-sm">
                                <i class="bi bi-trash-fill"></i> Sí, Eliminar Registro
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary text-center">
                                Cancelar y Regresar al Listado
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
